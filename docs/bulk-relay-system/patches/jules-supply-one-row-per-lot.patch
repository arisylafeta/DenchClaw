+import sys
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import jules_ready_supply_sync as sync
+
+
+class FakeCursor:
+    """Answers the two lookups fold_repeats makes from a list of existing CRM listings."""
+    def __init__(self, existing):
+        self.existing, self.result = existing, None
+
+    def execute(self, sql, params):
+        if 'source_id=%s' in sql:
+            self.result = {'x': 1} if any(e['source_id'] == params[0] for e in self.existing) else None
+        else:
+            email, quantity, *product = params
+            hits = [e for e in self.existing if e['open'] and e['email'] == email and e['quantity'] == quantity and e['product'] == tuple(product)]
+            self.result = {'source_id': hits[0]['source_id'], 'also': hits[0].get('also')} if hits else None
+
+    def fetchone(self):
+        return self.result
+
+
+def lead(cid, key='p1', email='seller@example.com', quantity=80, model='Leaf'):
+    return sync.listing({'conversation_id': cid, 'preview_key': key, 'contact_email': email,
+                         'draft': {'quantity': quantity, 'manufacturer': 'Nissan', 'model': model, 'packKwh': 40, 'format': 'Pack'}}, False)
+
+
+PRODUCT = ('nissan', 'leaf', '40', '', 'pack')
+
+
+class RepeatTests(unittest.TestCase):
+    def test_same_lot_open_in_the_crm_updates_that_listing(self):
+        rows = [lead('c-new')]
+        cur = FakeCursor([{'source_id': 'c-old:p1', 'open': True, 'email': 'seller@example.com', 'quantity': '80', 'product': PRODUCT}])
+        self.assertEqual(sync.fold_repeats(cur, rows), 1)
+        self.assertEqual(rows[0]['source_id'], 'c-old:p1')
+        self.assertEqual(rows[0]['context']['jules_also_from'], ['c-new:p1'])
+        self.assertNotIn('jules_conversation_id', rows[0]['context'])
+
+    def test_repeats_in_one_run_become_one_row(self):
+        rows = [lead(f'c{i}') for i in range(29)]
+        self.assertEqual(sync.fold_repeats(FakeCursor([]), rows), 28)
+        self.assertEqual(len(rows), 1)
+        self.assertEqual(len(rows[0]['context']['jules_also_from']), 28)
+        self.assertEqual(len(sync.upsert_sql(rows).split('),(')), 1)
+
+    def test_a_different_quantity_product_seller_or_a_closed_lot_is_a_new_row(self):
+        existing = [{'source_id': 'c-old:p1', 'open': True, 'email': 'seller@example.com', 'quantity': '80', 'product': PRODUCT},
+                    {'source_id': 'c-shut:p1', 'open': False, 'email': 'other@example.com', 'quantity': '80', 'product': PRODUCT}]
+        rows = [lead('a', quantity=40), lead('b', model='Ariya'), lead('c', email='other@example.com')]
+        self.assertEqual(sync.fold_repeats(FakeCursor(existing), rows), 0)
+        self.assertEqual([r['source_id'] for r in rows], ['a:p1', 'b:p1', 'c:p1'])
+
+    def test_a_lead_already_in_the_crm_updates_its_own_row(self):
+        existing = [{'source_id': 'c-old:p1', 'open': True, 'email': 'seller@example.com', 'quantity': '80', 'product': PRODUCT},
+                    {'source_id': 'c-dup:p1', 'open': True, 'email': 'seller@example.com', 'quantity': '80', 'product': PRODUCT}]
+        rows = [lead('c-dup')]
+        self.assertEqual(sync.fold_repeats(FakeCursor(existing), rows), 0)
+        self.assertEqual(rows[0]['source_id'], 'c-dup:p1')
+
+    def test_no_email_or_no_product_is_never_folded(self):
+        rows = [lead('a', email=None), lead('b', email=None)]
+        self.assertEqual(sync.fold_repeats(FakeCursor([]), rows), 0)
+        self.assertEqual(len(rows), 2)
+
+
+if __name__ == '__main__':
+    unittest.main()
