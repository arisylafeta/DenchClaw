+def lot_key(row):
+    """One lot is one seller, one product and one quantity, however many Jules chats it came through. None when the
+    lead lacks the seller's email, the quantity or any product detail: then it cannot be told apart and stays its own row."""
+    spec = row['spec']
+    product = tuple(str(spec.get(k) or '').strip().lower() for k in ('manufacturer', 'model', 'packKwh', 'chemistry', 'format'))
+    if not row.get('email') or not row.get('quantity') or not any(product):
+        return None
+    return (row['email'], product, str(row['quantity']).strip())
+
+
+def fold_repeats(cur, rows):
+    """A lead for a lot that is already open in the CRM (or earlier in this run) updates that listing instead of adding
+    one: it takes the listing's source_id, so the upsert lands on it, and its own Jules chat is kept in
+    context.jules_also_from. A lead whose own source_id is already a listing updates that listing as before. Existing
+    duplicates are left as they are. Mutates rows in place; returns how many were folded."""
+    out, first, folded = [], {}, 0
+    for row in rows:
+        key = lot_key(row)
+        if key is None:
+            out.append(row)
+            continue
+        own = row['source_id']
+        if key in first:
+            target = first[key]
+            target['context']['jules_also_from'] = sorted(set(target['context'].get('jules_also_from') or []) | {own})
+            folded += 1
+            continue
+        cur.execute("SELECT 1 FROM crm_bulk_listings WHERE kind='supply' AND source_kind='jules' AND source_id=%s", (own,))
+        if not cur.fetchone():
+            email, product, quantity = key
+            cur.execute(
+                """SELECT source_id, context->'jules_also_from' AS also FROM crm_bulk_listings
+                    WHERE kind='supply' AND source_kind='jules' AND status <> 'closed' AND lower(email)=%s AND btrim(quantity)=%s
+                      AND lower(coalesce(spec->>'manufacturer',''))=%s AND lower(coalesce(spec->>'model',''))=%s
+                      AND lower(coalesce(spec->>'packKwh',''))=%s AND lower(coalesce(spec->>'chemistry',''))=%s
+                      AND lower(coalesce(spec->>'format',''))=%s
+                    ORDER BY created_at, id LIMIT 1""", (email, quantity, *product))
+            found = cur.fetchone()
+            if found:
+                # The open listing keeps its own chat as the main one; this chat is recorded beside it.
+                for k in ('jules_conversation_id', 'jules_preview_key', 'listing_id', 'submitted_at'):
+                    row['context'].pop(k, None)
+                row['context']['jules_also_from'] = sorted(set(found['also'] or []) | {own})
+                row['source_id'] = found['source_id']
+                folded += 1
+        first[key] = row
+        out.append(row)
+    rows[:] = out
+    return folded
+
+
