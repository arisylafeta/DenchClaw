# Optional Hermes backend. These credentials stay server-side.
# HERMES_API_KEY authenticates the API server; the dashboard credential below is separate.
DENCH_AGENT_BACKEND=openclaw
HERMES_API_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=
# Native hosted groups use the existing authenticated Hermes dashboard /api/ws endpoint.
# Set both to enable groups. Remote endpoints require wss; loopback may use ws.
HERMES_GATEWAY_WS_URL=
HERMES_GATEWAY_TOKEN=
# For a password-protected dashboard, use its existing Basic-auth sign-in instead.
# The credential remains in a server-only file; no token is exposed to the browser.
HERMES_GATEWAY_USERNAME=
HERMES_GATEWAY_PASSWORD_FILE=

WATCHPACK_POLLING=true
IRONCLAW_WEB_ENABLE_MCP_CONNECTORS=0
NEXT_PUBLIC_POSTHOG_KEY=phc_***

# ReBattery marketplace operations
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
NEXT_PUBLIC_SITE_URL=
STRIPE_GLOBAL_PAYOUTS_SECRET_KEY=
